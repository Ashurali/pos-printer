{
  "name": "ble-pos-printer",
  "version": "3.0.2",
  "description": "Backend-agnostic Bluetooth thermal/label printer manager for POS systems. Supports ESC/POS and TSPL with auto-detection, device profiles, and BLE chunked writes.",
  "keywords": [
    "bluetooth",
    "printer",
    "thermal",
    "pos",
    "escpos",
    "tspl",
    "receipt",
    "label",
    "web-bluetooth",
    "ble",
    "xprinter",
    "gold-shop"
  ],
  "author": "Ashurali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ashurali/ble-pos-printer.git"
  },
  "homepage": "https://github.com/Ashurali/ble-pos-printer#readme",
  "bugs": {
    "url": "https://github.com/Ashurali/ble-pos-printer/issues"
  },
  "main": "dist/printer-manager.umd.js",
  "module": "dist/printer-manager.esm.mjs",
  "browser": "dist/printer-manager.umd.js",
  "types": "dist/printer-manager.d.ts",
  "exports": {
    ".": {
      "import": "./dist/printer-manager.esm.mjs",
      "require": "./dist/printer-manager.umd.js",
      "default": "./dist/printer-manager.umd.js"
    },
    "./setup": {
      "import": "./dist/printer-setup.esm.mjs",
      "require": "./dist/printer-setup.umd.js",
      "default": "./dist/printer-setup.umd.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/printer-manager.test.js && node --test test/esm-import.test.mjs",
    "test:cjs": "node --test test/printer-manager.test.js",
    "test:esm": "node --test test/esm-import.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.20.2"
  },
  "engines": {
    "node": ">=14"
  }
}
