<%# app/views/printer_settings/show.html.erb %>

<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="text-2xl font-bold mb-6">⚙️ Pengaturan Printer</h1>

  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-4">
      <%= notice %>
    </div>
  <% end %>

  <%# Server-side form for saving to DB %>
  <%= form_with model: @printer_setting, url: printer_settings_path, method: :patch, class: "space-y-6 mb-8" do |f| %>
    <div class="bg-white border rounded-xl p-6 shadow-sm space-y-4">
      <h2 class="text-lg font-semibold">Konfigurasi Server</h2>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Lebar Kertas</label>
          <%= f.select :paper_width, PrinterSetting::PAPER_WIDTHS, {}, class: "w-full border rounded-lg px-3 py-2" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Cash Drawer Pin</label>
          <%= f.select :cash_drawer_pin, PrinterSetting::DRAWER_PINS, {}, class: "w-full border rounded-lg px-3 py-2" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Chunk Size (bytes)</label>
          <%= f.number_field :chunk_size, class: "w-full border rounded-lg px-3 py-2", min: 64, max: 4096 %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1">Chunk Delay (ms)</label>
          <%= f.number_field :chunk_delay, class: "w-full border rounded-lg px-3 py-2", min: 0, max: 500 %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <%= f.check_box :auto_reconnect, class: "w-4 h-4" %>
        <label class="text-sm text-gray-700">Auto-reconnect jika terputus</label>
      </div>

      <%= f.submit 'Simpan Pengaturan', class: "bg-amber-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-amber-700 cursor-pointer" %>
    </div>
  <% end %>

  <%# Client-side Bluetooth Setup (rendered by JS) %>
  <div id="printer-setup-widget"></div>
</div>

<%# Include the JS modules %>
<%= javascript_include_tag 'printer-manager', defer: true %>
<%= javascript_include_tag 'printer-setup', defer: true %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Load server config and initialize the setup widget
    const serverConfig = <%= raw (@printer_setting.persisted? ? @printer_setting.to_js_config : {}).to_json %>;

    const printer = new PrinterManager(serverConfig);
    const setup = new PrinterSetup(document.getElementById('printer-setup-widget'), {
      printerManager: printer,
      onConfigSaved: function(config) {
        // Optionally sync back to server
        fetch('<%= printer_settings_path(format: :json) %>', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content,
          },
          body: JSON.stringify({ printer_setting: { device_name: config.name, device_id: config.id } }),
        });
      },
    });

    // Expose globally for debugging
    window.goldposPrinter = printer;
  });
</script>
